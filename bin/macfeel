#!/usr/bin/env bash
# macfeel — make macOS feel like Linux. Reversible, auditable, no SIP changes.
#
#   macfeel list [profile]        show the tweaks a profile would change
#   macfeel status [profile]      show current vs desired for every tweak
#   macfeel apply [profile]       snapshot, then write the tweaks (default: linux)
#   macfeel apply --dry-run       print what would change, write nothing
#   macfeel restore [snapshot]    restore a snapshot (default: the oldest one)
#   macfeel set <id> [--unset]    write or remove a single tweak
#   macfeel ui [--port N]         open the local control panel
#   macfeel snapshot              take a snapshot without changing anything
#   macfeel doctor                environment + safety checks
#   macfeel about                 version, licence, coffee
#
# Env: MACFEEL_HOME (default ~/.macfeel), MACFEEL_LANG (en | zh_Hant | zh_Hans)
set -euo pipefail

VERSION="0.1.0"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TWEAKS="$HERE/lib/tweaks.conf"
I18N="$HERE/lib/i18n"
HOME_DIR="${MACFEEL_HOME:-$HOME/.macfeel}"
SNAP_ROOT="$HOME_DIR/snapshots"

die()  { printf 'macfeel: %s\n' "$*" >&2; exit 1; }
say()  { printf '%s\n' "$*"; }
note() { printf '  %s\n' "$*"; }

[ "$(uname -s)" = "Darwin" ] || die "macfeel: this tool only runs on macOS"

# ------------------------------------------------------------------- language ---
detect_lang() {
  if [ -n "${MACFEEL_LANG:-}" ]; then printf '%s' "$MACFEEL_LANG"; return; fi
  local loc; loc="$(defaults read -g AppleLocale 2>/dev/null || true)"
  [ -n "$loc" ] || loc="${LANG:-}"
  case "$loc" in
    zh*Hans*|zh_CN*|zh_SG*|zh-Hans*) printf 'zh_Hans' ;;
    zh*|zh_TW*|zh_HK*|zh-Hant*)      printf 'zh_Hant' ;;
    *)                               printf 'en' ;;
  esac
}
LANG_CODE="$(detect_lang)"
case "$LANG_CODE" in en|zh_Hant|zh_Hans) ;; *) LANG_CODE="en" ;; esac

lang_col() {  # key + one column per language in lib/i18n/*.tsv
  case "$1" in
    en)      echo 2 ;;
    zh_Hant) echo 3 ;;
    zh_Hans) echo 4 ;;
    *)       echo 2 ;;
  esac
}

_t_lookup() {  # file key -> localized text (falls back to English, never to a bare key)
  local file="$1" key="$2" col; col="$(lang_col "$LANG_CODE")"
  local line; line="$(awk -F'\t' -v k="$key" '$1==k {print; exit}' "$file")"
  [ -n "$line" ] || { printf '%s' "$key"; return; }
  local text; text="$(printf '%s' "$line" | cut -f"$col")"
  [ -n "$text" ] || text="$(printf '%s' "$line" | cut -f2)"
  printf '%s' "$text"
}

t() {  # t <key> [name=value]...  — substitutes {placeholders}
  local key="$1"; shift || true
  local text; text="$(_t_lookup "$I18N/ui.tsv" "$key")"
  local pair name val
  for pair in "$@"; do
    name="${pair%%=*}"; val="${pair#*=}"
    text="${text//\{$name\}/$val}"
  done
  printf '%s' "$text"
}

i18n_text() { _t_lookup "$1" "$2"; }   # file id

# ---------------------------------------------------------------- tweak table ---
read_tweaks() {
  [ -f "$TWEAKS" ] || die "missing tweak table: $TWEAKS"
  awk -F'\t' 'NF==8 && $1 !~ /^#/ {print}' "$TWEAKS"
}

in_profile() { case ",$1," in *",$2,"*) return 0 ;; esac; return 1; }

read_value() { defaults read "$1" "$2" 2>/dev/null || true; }

normalise() {  # collapse the shapes defaults prints (1 vs true, -1 vs -1.0)
  local v="$1"
  case "$v" in
    true|TRUE|1) v=1 ;; false|FALSE|0) v=0 ;;
  esac
  if [[ "$v" =~ ^-?[0-9]+\.?[0-9]*$ ]]; then
    printf '%s' "$v" | awk '{printf "%.6f", $1}'
  else
    printf '%s' "$v"
  fi
}

expand_tilde() {  # defaults expands ~ itself; compare the expanded form or paths read as drift
  case "$1" in \~*) printf '%s' "${1/#\~/$HOME}" ;; *) printf '%s' "$1" ;; esac
}

write_value() {  # domain key type value
  local domain="$1" key="$2" type="$3" value="$4"
  value="$(expand_tilde "$value")"
  case "$type" in
    bool)   [[ "$value" == "true" || "$value" == "false" ]] || die "bool tweak needs true/false: $key=$value"
            defaults write "$domain" "$key" -bool "$value" ;;
    int)    defaults write "$domain" "$key" -int "$value" ;;
    float)  defaults write "$domain" "$key" -float "$value" ;;
    string) defaults write "$domain" "$key" -string "$value" ;;
    *)      die "unknown type '$type' for $key" ;;
  esac
}

export_domain() {
  local d="$1" out="$2"
  [[ "$d" == "-g" ]] && d="NSGlobalDomain"
  defaults export "$d" "$out" 2>/dev/null
}

# ------------------------------------------------------------------- snapshot ---
take_snapshot() {
  local stamp dir
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  dir="$SNAP_ROOT/$stamp"
  mkdir -p "$dir"
  local seen=" "
  while IFS=$'\t' read -r _ _ domain _ _ _ _ _; do
    case "$seen" in *" $domain "*) continue ;; esac
    seen="$seen$domain "
    local name="${domain#-g}"; name="${name:-NSGlobalDomain}"
    export_domain "$domain" "$dir/$name.plist" || true
  done < <(read_tweaks)
  printf '%s\n' "$dir" > "$HOME_DIR/last-snapshot"
  say "$dir"
}

# ------------------------------------------------------------------- commands ---
cmd_list() {
  local profile="${1:-linux}"
  while IFS=$'\t' read -r id profiles domain key type value needs desc; do
    in_profile "$profiles" "$profile" || continue
    printf '%-22s %-7s %s=%s\n' "$id" "$type" "$key" "$value"
    printf '  %s\n' "$(i18n_text "$I18N/desc.tsv" "$id")"
  done < <(read_tweaks)
}

cmd_status() {
  local profile="${1:-linux}" drift=0 total=0
  printf '%-22s %-8s %s\n' "ID" "STATE" "CURRENT -> WANTED"
  while IFS=$'\t' read -r id profiles domain key type value needs desc; do
    in_profile "$profiles" "$profile" || continue
    total=$((total + 1))
    local cur want; cur="$(read_value "$domain" "$key")"; want="$(expand_tilde "$value")"
    if [ -z "$cur" ]; then
      printf '%-22s %-8s %s\n' "$id" "unset" "-> $want"; drift=$((drift + 1)); continue
    fi
    if [ "$(normalise "$cur")" = "$(normalise "$want")" ]; then
      printf '%-22s %-8s %s\n' "$id" "ok" "$cur"
    else
      printf '%-22s %-8s %s -> %s\n' "$id" "drift" "$cur" "$want"; drift=$((drift + 1))
    fi
  done < <(read_tweaks)
  say ""
  say "$((total - drift))/$total $(t cli.status.matched profile="$profile")"
}

cmd_apply() {
  local profile="linux" dry=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run|-n) dry=1 ;;
      --help|-h) sed -n '2,16p' "$0"; return 0 ;;
      -*) die "unknown flag $1" ;;
      *) profile="$1" ;;
    esac
    shift
  done

  # Collect what actually differs first: a snapshot of an already-applied machine is not a
  # restore point, it is a copy of the change.
  local pending; pending="$(mktemp "${TMPDIR:-/tmp}/macfeel.XXXXXX")"
  trap 'rm -f "$pending"' RETURN
  while IFS=$'\t' read -r id profiles domain key type value needs desc; do
    in_profile "$profiles" "$profile" || continue
    local cur want; cur="$(read_value "$domain" "$key")"; want="$(expand_tilde "$value")"
    if [ -n "$cur" ] && [ "$(normalise "$cur")" = "$(normalise "$want")" ]; then continue; fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$profiles" "$domain" "$key" "$type" "$value" "$needs" "$desc" >> "$pending"
  done < <(read_tweaks)

  local count; count="$(wc -l < "$pending" | tr -d ' ')"
  if [ "$count" = "0" ]; then
    say "$(t cli.already profile="$profile")"
    return 0
  fi

  if [ $dry -eq 1 ]; then
    say "$(t cli.dry count="$count")"
    while IFS=$'\t' read -r id _ _ key _ value _ _; do
      printf '  %-9s %-22s %s=%s\n' "$(t cli.would)" "$id" "$key" "$value"
      printf '  %-9s %s\n' "" "$(i18n_text "$I18N/desc.tsv" "$id")"
    done < "$pending"
    return 0
  fi

  local snap; snap="$(take_snapshot)"
  say "$(t cli.snapshot): $snap"
  local changed=0 hints=" "
  while IFS=$'\t' read -r id _ domain key type value needs desc; do
    write_value "$domain" "$key" "$type" "$value"
    local now want2; now="$(read_value "$domain" "$key")"; want2="$(expand_tilde "$value")"
    if [ "$(normalise "$now")" = "$(normalise "$want2")" ]; then
      printf '  %-9s %-22s %s=%s\n' "$(t cli.set)" "$id" "$key" "$value"
    else
      printf '  %-9s %-22s %s=%s (reads %s)\n' "$(t cli.failed)" "$id" "$key" "$value" "$now" >&2
    fi
    changed=$((changed + 1))
    case "$needs" in
      dock)     hints="$hints dock" ;;
      finder)   hints="$hints finder" ;;
      uiserver) hints="$hints uiserver" ;;
      logout)   hints="$hints logout" ;;
    esac
  done < "$pending"

  local shotdir; shotdir="$(read_value com.apple.screencapture location || true)"
  [ -n "$shotdir" ] && mkdir -p "$shotdir" 2>/dev/null || true

  say ""
  say "$(t cli.changed count="$changed")"
  case "$hints" in *" dock"*) killall Dock 2>/dev/null || true; note "$(t cli.dock)" ;; esac
  case "$hints" in *" finder"*) killall Finder 2>/dev/null || true; note "$(t cli.finder)" ;; esac
  case "$hints" in *" uiserver"*) killall SystemUIServer 2>/dev/null || true; note "$(t cli.uiserver)" ;; esac
  case "$hints" in *" logout"*) note "$(t cli.logout)" ;; esac
  note "$(t cli.restore-hint)"
}

cmd_restore() {
  local dir="${1:-}"
  if [ -z "$dir" ]; then
    dir="$(ls -1d "$SNAP_ROOT"/*/ 2>/dev/null | sort | head -1)"
    [ -n "$dir" ] || die "$(t cli.no-snapshot)"
    dir="${dir%/}"
  fi
  [ -d "$dir" ] || die "no such snapshot: $dir"
  python3 "$HERE/lib/restore.py" "$dir" "$TWEAKS"
  killall Dock 2>/dev/null || true
  killall Finder 2>/dev/null || true
  killall SystemUIServer 2>/dev/null || true
  say "$(t cli.restored dir="$dir")"
}

cmd_set() {  # <id> | <id> --unset
  local id="${1:-}" unset=0
  [ "${2:-}" = "--unset" ] && unset=1
  [ -n "$id" ] || die "usage: macfeel set <id> [--unset]"
  local found=0
  while IFS=$'\t' read -r tid profiles domain key type value needs desc; do
    [ "$tid" = "$id" ] || continue
    found=1
    if [ $unset -eq 1 ]; then
      defaults delete "$domain" "$key" 2>/dev/null || true
      say "unset $id ($domain $key)"
    else
      write_value "$domain" "$key" "$type" "$value"
      local now; now="$(read_value "$domain" "$key")"
      [ "$(normalise "$now")" = "$(normalise "$(expand_tilde "$value")")" ] \
        && say "set $id = $value" || die "write did not stick: $id reads $now"
    fi
  done < <(read_tweaks)
  [ $found -eq 1 ] || die "unknown tweak id: $id"
}

cmd_doctor() {
  say "macfeel $VERSION · lang $LANG_CODE"
  say "macOS:      $(sw_vers -productVersion) ($(sw_vers -buildVersion))"
  say "SIP:        $(csrutil status 2>/dev/null | sed 's/.*: //')"
  say "snapshots:  $SNAP_ROOT"
  say "tweaks:     $(read_tweaks | wc -l | tr -d ' ')"
  say ""
  say "$(t cli.doctor.profiles):"
  for p in linux minimal chrome; do
    say "  $p: $(read_tweaks | awk -F'\t' -v p="$p" '$2 ~ ("(^|,)" p "(,|$)")' | wc -l | tr -d ' ')"
  done
  say ""
  say "$(t cli.doctor.safety)"
}

cmd_about() {
  say "macfeel $VERSION — $(t app.tagline)"
  say "$(t cli.about)"
  say "$(t cli.coffee)"
}

# ----------------------------------------------------------------------- main ---
cmd="${1:-}"; shift || true
case "$cmd" in
  list)     cmd_list "${1:-linux}" ;;
  status)   cmd_status "${1:-linux}" ;;
  apply)    cmd_apply "$@" ;;
  restore)  cmd_restore "$@" ;;
  set)      cmd_set "$@" ;;
  snapshot) take_snapshot ;;
  ui)       exec python3 "$HERE/lib/ui.py" --lang "$LANG_CODE" "$@" ;;
  doctor)   cmd_doctor ;;
  about)    cmd_about ;;
  ""|-h|--help|help) sed -n '2,16p' "$0" ;;
  *) die "$(t cli.unknown cmd="$cmd")" ;;
esac
