<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Measured on macOS 27.2 with ~/dev/macfeel-spike: without this entitlement a
	     sandboxed build writes into its own container and the real preference
	     plists never change. kCFPreferencesAnyApplication is the string that grants
	     the global domain; ".GlobalPreferences" and "NSGlobalDomain" do not. -->
	<key>com.apple.security.temporary-exception.shared-preference.read-write</key>
	<array>
		<string>com.apple.dock</string>
		<string>com.apple.finder</string>
		<string>com.apple.screencapture</string>
		<string>com.apple.AppleMultitouchTrackpad</string>
		<string>kCFPreferencesAnyApplication</string>
	</array>
</dict>
</plist>
